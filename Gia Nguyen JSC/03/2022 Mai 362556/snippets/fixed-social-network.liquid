<div id="fixed-social-network" class="medium--hide small--hide">
	{%if settings.use_social_facebook%}
	<a href="{{settings.social_facebook_link}}" class="fb-icon"><i class="fa fa-facebook" aria-hidden="true"></i> Facebook</a>
	{%endif%}
	{%if settings.use_social_instagram%}
	<a href="{{settings.social_instagram_link}}" class="ins-icon"><i class="fa fa-instagram" aria-hidden="true"></i> Instagram</a>
	{%endif%}
	{%if settings.use_social_youtube%}
	<a href="{{settings.social_youtube_link}}" class="yt-icon"><i class="fa fa-youtube-play" aria-hidden="true"></i> Youtube</a>
	{%endif%}							
	{%if settings.use_social_twitter%}					
	<a href="{{settings.social_twitter_link}}" class="tw-icon"><i class="fa fa-twitter" aria-hidden="true"></i> Twitter</a>
	{%endif%}
	{%if settings.use_social_googleplus%}
	<a href="{{settings.social_google_link}}" class="gg-icon"><i class="fa fa-google-plus" aria-hidden="true"></i> Google+</a>
	{%endif%}	
	<a href="javascript:void(0)" id="back-to-top"><i class="fa fa-angle-up" aria-hidden="true"></i> Top</a>
</div>

