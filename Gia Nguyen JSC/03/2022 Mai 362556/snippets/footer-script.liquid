{% if template contains 'index' %}
<script>
	$('.scroll_id').click(function(){
		var link  = $(this).attr('href');
		console.log(link);
		var target = $(link).offset().top - 10;

		$('body, html').animate({
			scrollTop: target
		}, 500);
	});
</script>
