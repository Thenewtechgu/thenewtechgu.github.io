<script>
	$(document).ready(function(){

		var box2 = document.querySelector('#menu_mb');
		var box2_click = document.querySelector('#menu_mb >.nav_mobile_all');

		var outside2 = function(event) {
			if (!box2_click.contains(event.target)) {
				box2.classList.remove('active');	
				//console.log('removing outside listener on document')
				this.removeEventListener(event.type, outside2);
			}
		}

		document.querySelector('#show_navmobile').addEventListener('click', function(event) {
			event.preventDefault();
			event.stopPropagation();
			box2.classList.add('active');
			document.addEventListener('click', outside2);
		});
		$('#hide_nav_mb').click(function(){
			box2.classList.remove('active');	
		});

		//------------------------ send_form --------------------------------//
		var send_form = document.querySelector('#send_form');
		function show3(){
			send_form.classList.add('active');	
		}
		$(document).on('click' ,'.show_form_service', function(e){
			e.preventDefault();
			send_form.classList.add('active');	
		});
		$(document).on('click' ,'#hide_send_form', function(e){
			e.preventDefault();
			send_form.classList.remove('active');	
		});




		//------------------------ count up  --------------------------------//

		{% comment %}
		var alreadyRun = false;
		 $(window).scroll(function(){
			 var docViewTop = $(window).scrollTop();
			 var docViewBottom = docViewTop + $(window).height();

			 var elemTop = $("#conet_up").offset().top;
			 var elemBottom = elemTop + $("#conet_up").height();

			 if (alreadyRun == false &&(elemBottom <= docViewBottom) && (elemTop >= docViewTop)) {
				 alreadyRun = true;
				 start_count();
			 }
		 });


		 function start_count(){
			 $('.counter').each(function() {
				 var $this = $(this),
						 countTo = $this.attr('data-count');
				 $({ countNum: $this.text()}).animate({
					 countNum: countTo
				 },{
					 duration: 3000,
					 easing:'linear',
					 step: function() {
						 $this.text(Math.floor(this.countNum));
					 },
					 complete: function(){ $this.text(this.countNum);
															 }
				 });
			 });
		 }
		 {% endcomment %}
		 //------------------------ about bình luận của khách hàng  --------------------------------//
		 $('#blog1_owl').owlCarousel({
			 loop:false,
			 nav:false,
			 dots: true,
			 margin: 20,
			 responsive:{
				 0:{
					 items:1
				 },
				 600:{
					 items:2
				 },
				 1000:{
					 items:3
				 }
			 }
		 });

		 });
</script>







<script>
