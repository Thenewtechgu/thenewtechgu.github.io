<!--========================= back to top =======================-->
<script>
	$(document).ready(function(){
		var width_man = $(window).width();
		$('body').append(
			'<div id="back_top"><a href="#"><i class="fas fa-chevron-up"></i></a></div>'
		);
		$(window).scroll(function () {
			if ($(this).scrollTop() > 300) {
				$('#back_top').addClass("back_to_top");
			}
			else {
				$('#back_top').removeClass("back_to_top");
			}
		});
		$('body').on('click', '#back_top a', function () {
			$("html,body").animate({ scrollTop: 0 }, 1000);
			return false;
		});
		var height_hd = $('#header').outerHeight();

		$(window).scroll(function(){
			if ($(this).scrollTop() > height_hd) {
				$("#header").addClass('active');
			}else{
				$("#header").removeClass('active');
			}
		});
	});
</script>




