
<section id="home-price">
	<div class="wrapper">
		<div class="inner">
			<div class="title">
				<div class="">
					<img src="{{'price_img.png' |asset_url}}" alt="icon">
				</div>
				<h2>{{ settings.price_title }}</h2>
			</div>
			<div class="grid">
				{%for j in (1..4)%}
				{%capture _price_show%}price_show_{{j}}{%endcapture%}
				{%capture _price_price%}price_price{{j}}{%endcapture%}
				{%capture -price_time%}price_time{{j}}{%endcapture%}
				{%capture _price_title%}price_title{{j}}{%endcapture%}			
				{%capture _price_desc_1%}price_desc_1_{{j}}{%endcapture%}
				{%capture _price_desc_2%}price_desc_2_{{j}}{%endcapture%}
				{%capture _price_desc_3%}price_desc_3_{{j}}{%endcapture%}
				{%capture _price_desc_4%}price_desc_4_{{j}}{%endcapture%}
				{%capture _price_desc_5%}price_desc_5_{{j}}{%endcapture%}
				{%capture _price_service%}price_service_{{j}}{%endcapture%}
				{%if settings[_price_show]%}
				<div class="grid__item  mg-bt30 large--one-quarter medium--one-hafl small--one-whole">
					<div class="price_all">
						<div class="price_title">
							<p class="p1">{{settings[_price_price] | money}}</p>
							<span class="p2">/ {{settings[price_time]}}</span>
							<h3>{{settings[_price_title]}}</h3>
						</div>	
						<div class="price_content">
							<ul class="no-bullets">
								<li>{{settings[_price_desc_1]}}</li>
								<li>{{settings[_price_desc_2]}}</li>
								<li>{{settings[_price_desc_3]}}</li>
								<li>{{settings[_price_desc_4]}}</li>
								<li>{{settings[_price_desc_5]}}</li>
							</ul>
							<a class="show_form_service   button_all" href="javascript:void(0)">{{settings[_price_service]}}</a>
						</div>
					</div>
				</div>
				{%endif%}
				{%endfor%}
			</div>
		</div>
	</div>
</section>