{% assign mota = article.content | split : '<p>####</p>' %}

<section id="blog-wrapper">
	<div class="wrapper">
		<div class="inner">
			<div class="grid">

				<article class="float-right grid__item large--nine-twelfths medium--one-whole small--one-whole" itemscope itemtype="http://schema.org/Article">

					<div class="article-content">
						<div class="article-head">
							<h1>{{article.title}}</h1>							
							<div class="grid mg-left-15">
								<div class="grid__item large--one-half medium--one-half small--one-half pd-left15">
									<div class="article-date-comment">
										<div class="date"><i class="fas fa-calendar-alt"></i> {{ article.published_at | date: '%d/%m/%y' }}</div>
										<div class="comment"><i class="fas fa-comment-alt"></i> <span class="fb-comments-count" data-href="{{shop.url}}{{article.url}}"></span></div>
										<div class="author">
											<i class="fas fa-user"></i> {{article.author}}
										</div>									
									</div>
								</div>
								<div class="grid__item large--one-half medium--one-half small--one-half pd-left15">
									<div class="social-network-actions text-right">
										<div class="fb-like" data-href="{{shop.url}}{{article.url}}" data-layout="button_count" data-action="like" data-size="small" data-show-faces="true" data-share="true"></div>
									</div>
								</div>
							</div>
						</div>
						{%if settings.use_article_tldr%}
						<div class="article-tldr clearfix">
							{% if article.excerpt == blank %}
							{{ article.content | truncatewords: 140 }}
							{% else %}
							{{ article.excerpt }}
							{% endif %}
						</div>
						{%endif%}
						<div class="article-body">
							<div class="tab clearfix">
								{%if settings.article_tab_show1%}
								<button class="pro-tablinks" onclick="openArticleTabs(event, 'proTab1')" id="defaultOpenArticleTabs">{{settings.articletab_title1}}</button>
								{%endif%}		
								{%if settings.article_tab_show2%}						
								<button class="pro-tablinks" onclick="openArticleTabs(event, 'proTab2')">{{settings.articletab_title2}}</button>
								{%endif%}
								{%if settings.article_tab_show3%}
								<button class="pro-tablinks" onclick="openArticleTabs(event, 'proTab3')">{{settings.articletab_title3}}</button>
								{%endif%}
							</div>
							{%if settings.article_tab_show1%}
							<div id="proTab1" class="pro-tabcontent">
								{{ mota[0] }}
							</div>
							{%endif%}
							{%if settings.article_tab_show2%}
							<div id="proTab2" class="pro-tabcontent">
								{{ mota[1] }}
							</div>
							{%endif%}
							{%if settings.article_tab_show3%}
							<div id="proTab3" class="pro-tabcontent">
								<div class="hcontact-wrapper">
									<h2>
										{{settings.hcontact_title}}
									</h2>
									<div class="hcontact-desc">
										{{settings.hcontact_desc}}
									</div>
									<div class="hcontact-form">
										<div class="form-vertical clearfix">
											{% form 'contact' %}

											{% comment %}
											Successful message
											{% endcomment %}
											{% if form.posted_successfully? %}
											<p class="note form-success">
												{{ 'contact.form.post_success' | t }}
											</p>
											{% endif %}

											{{ form.errors | default_errors }}

											{% assign name_attr = 'contact.form.name' | t | handle %}
											<label for="ContactFormName" class="hidden-label">{{ 'contact.form.name' | t }}</label>
											<input type="text" id="ContactFormName" class="input-full" name="contact[name]" required placeholder="{{ 'contact.form.name' | t }}" autocapitalize="words" value="{% if form[name_attr] %}{{ form[name_attr] }}{% elsif customer %}{{ customer.name }}{% endif %}">

											<label for="ContactFormEmail" class="hidden-label">{{ 'contact.form.email' | t }}</label>
											<input type="email" id="ContactFormEmail" class="input-full" name="contact[email]" required placeholder="{{ 'contact.form.email' | t }}" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">

											{% assign name_attr = 'contact.form.phone' | t | handle %}
											<label for="ContactFormPhone" class="hidden-label">{{ 'contact.form.phone' | t }}</label>
											<input type="tel" id="ContactFormPhone" class="input-full" name="contact[phone]" required placeholder="{{ 'contact.form.phone' | t }}" pattern="[0-9\-]*" value="{% if form[name_attr] %}{{ form[name_attr] }}{% elsif customer %}{{ customer.phone }}{% endif %}">

											<label for="ContactFormMessage" class="hidden-label">{{ 'contact.form.message' | t }}</label>
											<textarea rows="10" id="ContactFormMessage" class="input-full" name="contact[body]" required placeholder="{{ 'contact.form.message' | t }}">{% if form.body %}{{ form.body }}{% endif %}</textarea>

											<div class="text-center">
												<input type="submit" class="btn btnContactSubmit" value="{{settings.hcontact_btn}}">
											</div>

											{% endform %}
										</div>
									</div>
								</div>
							</div>
							{%endif%}
						</div>
						{%if article.tags != blank%}
						<div class="article-tags clearfix">
							<span>Từ khóa:</span>
							{% for tag in article.tags %}
							{%unless tag contains '#loai_'%}
							<a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
							{%endunless%}
							{% endfor %}
						</div>
						{%endif%}
					</div>
					<div class="social-network-actions-outside text-right">
						<div class="fb-send" data-href="{{shop.url}}{{article.url}}"></div>
						<div class="fb-like" data-href="{{shop.url}}{{article.url}}" data-layout="button" data-action="like" data-size="small" data-show-faces="true" data-share="true"></div>
					</div>
					<div id="section-fbcomment" class="fb-comments-wrapper">
						<div class="fb-comments" data-href="{{shop.url}}{{article.url}}" data-numposts="5"></div>
					</div>
					{%if blogs[blog.handle].articles_count > 1%}
					<div class="related-articles">
						<div class="related-articles-head">
							<h3>
								{{settings.related_articles_title}}
							</h3>
						</div>
						<div class="related-articles-body">
							<ul class="no-bullets">
								{% for _article in blogs[blog.handle].articles limit:settings.blog_sidebar_recent_number %}
								{%if article.url != _article.url%}
								<li>
									<a href="{{ _article.url }}">{{ _article.title }}</a>
								</li>
								{%endif%}
								{% endfor %}
							</ul>
						</div>
					</div>
					{%endif%}

				</article>

				<div class="grid__item large--three-twelfths medium--one-whole small--one-whole">
					{%include 'blog-sidebar'%}
				</div>

			</div>
		</div>
	</div>
</section>
