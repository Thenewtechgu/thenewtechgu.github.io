{% layout 'en' %}
<section id="blogs">
	<div class="wrapper">
		<div class="inner">
			<div class="grid clearfix">
				<div class="grid__item 
										{%if settings.en_blog_sidebar_show%}
										right large--three-quarters
										{%else%}
										large--one-whole
										{%endif%}

										medium--one-whole small--one-whole">
					{%paginate blog.articles by settings.en_blog_limit %}
					<div class="blog_content">
						<div class="blog-content-wrapper">
							<div class="blog_body">
								<div class="grid-uniform">
									{%if blog.articles_count > 0%}
									{%for article_layout in blog.articles%}
									<div class="grid__item mg-bt30 large--one-half medium--one-half small--one-whole">
										{%include 'en-article-item'%}
									</div>
									{%endfor%}
									{%else%}
									<div class="grid__item large--one-whole">
										<p>
											No item in this category !
										</p>
									</div>
									{%endif%}
								</div>
								{%include 'en-pagination'%}
							</div>
						</div>
					</div>
					{%endpaginate%}
				</div>
				{%if settings.en_blog_sidebar_show%}
				<div class="grid__item  left large--one-quarter medium--one-whole small--one-whole">
					{%include 'en-blog-sidebar'%}
				</div>
				{%endif%}
			</div>
		</div>
	</div>
</section>

