//=====================breadcrumb-wrapper=========================//
#breadcrumb-wrapper {
	border-bottom: solid 1px #e4e4e4;	
	position: relative;
	margin-bottom: 30px;
}
.breadcrumb-content {
	width: 100%;
	z-index: 10;
	position: absolute;
	top: 50%;
	left: 0;
	transform: translateY(-50%);
	-webkit-transform: translateY(-50%);
	.breadcrumb_all {
		text-align: center;
		.breadcrumb_title{
			h1{
				color: #fff;
				font-weight: bold;
				text-transform: capitalize;
			}
		}
	}
	.breadcrumb-small{
		position: relative;
		z-index: 2;
		a {
			color: #fff;
		}
		span {
			color: $main_cl_1;
		}
	}
}
#owl-collection-banners{
	a {
		display: block;
	}
}

.pagination-custom {
	display: flex;
	justify-content: center;
	align-items: center;
	border: 1px solid transparent;
	width: 100%;
	span {
		width: 40px;
		height: 40px;
		display: flex;
		justify-content: center;
		align-items: center;
		overflow: hidden;
		background-color: #f0f0f0;
		color: $body_cl_tt;
		font-size: 17px;
		margin: 0 5px;
		@extend %smooth-trans1;
		&:hover{
			background-color: $body_cl_tt;
			a{
				color: #fff;
			}
		}
		a{
			color: $body_cl_tt;
			width: 100%;
			height: 100%;
			display: flex;
			justify-content: center;
			align-items: center;
			@extend %smooth-trans1;
			i{
				font-size: 13px;
			}
		}
	}
	span.page.current {
		background-color: $body_cl_tt;
		color: #fff;
	}
}


@media(max-width: 768px){
	.breadcrumb-content {
		.breadcrumb_all{
			justify-content: center;
			text-align: center;
			.breadcrumb_title{
				margin-bottom: 15px;
			}
		}
	}
	.breadcrumb-content .breadcrumb_all .breadcrumb_title h1{
		font-size: 30px;
	}
}
@media(max-width: 480px){
	.breadcrumb-content .breadcrumb_all .breadcrumb_title h1 {
		font-size: 25px;

	}
}

