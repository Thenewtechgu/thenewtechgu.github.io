// checkbox


.sidebar-sort {
	.no-bullets {
		li {
			input[type="checkbox"] {
				-webkit-appearance: checkbox;
				-moz-appearance: checkbox;
				-webkit-appearance: none;
				-moz-appearance: none;
				appearance: none;
				width: 16px;
				height: 16px;
				background: none;
				border: 1px solid #c3c3c3;
				display: inline-block;
				overflow:hidden;
				vertical-align: middle;
				&:focus{
					outline: none;
				}
				&:checked {
					width: 16px;
					height: 16px;
					&:after{
						content:'\2714';
						font-size:14px;
						line-height:16px;
						text-align:center;
						display:block;
						outline:none;
						color: $main_cl_1;
						outline: 1px solid #fff;
					}
				}
			}
			input[type="radio"] {
				-webkit-appearance: checkbox;
				-moz-appearance: checkbox;
				-webkit-appearance: none;
				-moz-appearance: none;
				appearance: none;
				width: 16px;
				height: 16px;
				background: none;
				border: 1px solid #c3c3c3;
				display: inline-block;
				overflow:hidden;
				vertical-align: middle;
				&:focus{
					outline: none;
				}
				&:checked {
					width: 16px;
					height: 16px;
					&:after{
						content:'\2714';
						font-size:14px;
						line-height:16px;
						text-align:center;
						display:block;
						outline:none;
						color: $main_cl_1;
						outline: 1px solid #fff;
					}
				}
			}
		}
	}
}


//================================ nút ========================//


.button_all {
	padding: 10px 30px 10px 30px;
	-webkit-box-shadow: 0px 0px 36px -13px rgba(0, 0, 0, 0.75);
	-moz-box-shadow: 0px 0px 36px -13px rgba(0, 0, 0, 0.75);
	box-shadow: 0px 0px 36px -13px rgba(0, 0, 0, 0.75);
	background-color: $bt_bg;
	color: $bt_cl;
	border-radius: 35px;
	display: inline-block;
	border: solid 2px $bt_bd_cl;
	font-weight: bold;
	@extend %smooth-trans1;
	&:hover{
		background-color: $bt_bg_hv ;
		color: $bt_cl_hv;
	}
}


//================================ tiêu đề ========================//


.title{
	width: 58%;
	margin: 0 auto;
	text-align: center;
	margin-bottom: 45px;
	img{
		width: auto;
	}
	h2{
		font-size: 36px;
		font-weight: bold;
		display: inline-block;
		position: relative;
		text-transform: capitalize;
		color: $body_cl_tt;
		&::before {
			border-bottom: 2px solid #d1d1d1;
			content: " ";
			width: 100px;
			position: absolute;
			left: -120px;
			right: 0;
			top: calc(50% - 0px);
		}
		&::after {
			border-bottom: 2px solid #d1d1d1;
			content: " ";
			width: 100px;
			position: absolute;
			right: -120px;
			top: calc(50% - 0px);
		}
	}
	p{
		opacity: .8;
	}
}
@media(max-width: 768px){
	.title {
		width: 85%;
		margin-bottom: 25px;
		h2 {
			font-size: 30px;
			&::before,&::after {
				display: none;
			}
		}
	}
}
@media(max-width: 480px){
	.title h2 {
		font-size: 25px !important;
		margin-top: 10px !important;
	}
}









.position_relative{
	position: relative !important;
}



@keyframes show_header {
	0%   {position: fixed; transform: translateY(-200%);}
	100%  {position: fixed;transform: translateY(0%); z-index: 1000;}

}



