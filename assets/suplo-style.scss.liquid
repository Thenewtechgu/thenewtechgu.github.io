			.product_cart_bottom{
				a{
					background-color: $bt_bg_hv;
					color: #fff;
					&::after{
						background-color: $bt_bg_hv;
					}
				}
				a.not_cart{
					cursor: not-allowed !important;
				}
			}
		}
		.product_img{
			.product_cart{
				a,>div{
					transform: translate(0) !important;
					opacity: 1 !important;
					visibility: visible;
				}
			}
			.product_imgs{
				.product_empty {
					opacity:1;
				}
			}
		}
	}
	.product_img{
		position: relative;
		overflow: hidden;
		z-index: 2;
		.product_empty {
			position: absolute;
			width: 100%;
			height: 100%;
			background-color: rgba(0,0,0,0.2);
			z-index: 1;
			pointer-events: none;
			opacity: 0;
			@extend %smooth-trans;
		}
		.product_sale {
			position: absolute;
			top: 4%;
			left: 0;
			z-index: 2;
			width: 100%;
			padding: 0 4%;
			span {
				color: #fff;
				padding: 0 11px;
				width: auto;
				height: auto;
				display: flex;
				justify-content: center;
				align-items: center;
				background-color: $bt_bg_hv;
				margin-bottom: 10px;
			}
			span.sale1{
				background-color: $body_cl_tt_hv;
			}
			span.sold_out{
				background-color: #f00;
				cursor: not-allowed !important;
			}
		}
		.product_imgs{
			a{
				position: relative;
				display: block;
				.product_empty {
					background: rgba(255,255,255,0.5);
					height: 100%;
					left: 0;
					top: -100%;
					width: 100%;
					position: absolute;
					z-index: 1;
					opacity: 0;
					visibility: hidden;
					@extend %smooth-trans1;
				}
				img{
					&:nth-child(2){
						visibility: hidden;
						position: absolute;
						top: 0;
						left: 0;
						opacity: 0;
						transform: rotateY(90deg);
						@extend %smooth-trans1;
					}
				}
			}
		}
		.product_cart {
			position: absolute;
			z-index: 2;
			bottom: 0;
			left: 0;
			right: 0;
			display: flex;
			justify-content: center;
			.a_a{
				&:nth-child(1) {
					transition-delay: 100ms;
				}
				&:nth-child(2) {
					transition-delay: 200ms;
				}
				&:nth-child(3) {
					transition-delay: 300ms;
				}
				&:nth-child(4) {
					transition-delay: 400ms;
				}
			}
			>div{
				span.sp_color_one {
					width: 15px;
					height: 15px;
					display: inline-block;
					background-color: $main_cl_2;
					border-radius: 100%;
				}
				&:hover{
					>div{
						label{
							visibility: visible;
						}
					}
				}
				>div{
					position: absolute;
					bottom: 100%;
					label {
						width: 50px;
						height: 45px;
						display: flex;
						justify-content: center;
						align-items: center;
						background-color: rgba(255,255,255,0.8);
						margin: 1px 0;
						visibility: hidden;
						transition-property: all;
						transition-timing-function: linear;
						transition-duration: .4s;
						&:nth-child(1){
							transition-delay: 50ms;
						}
						&:nth-child(2){
							transition-delay: 100ms;
						}
						&:nth-child(3){
							transition-delay: 150ms;
						}
						&:nth-child(4){
							transition-delay: 200ms;
						}
						&:nth-child(5){
							transition-delay: 250ms;
						}
						&:nth-child(6){
							transition-delay: 300ms;
						}
						&:nth-child(7){
							transition-delay: 350ms;
						}
						&:nth-child(8){
							transition-delay: 400ms;
						}
						&:hover{
							cursor: pointer;
							span{
								color: $main_cl_1;
							}
						}
						span{
							color: $main_cl_2;
						}
						input[type="radio"] {
							position: absolute;
							opacity: 0;
							z-index: -1;
						}
						span.sp_color {
							width: 15px;
							height: 15px;
							border-radius: 100%;
							border: solid 1px #ccc;
						}
					}
				}
			}
			a,>div{
				background: #fff;
				color: $main_cl_2;
				font-size: 18px;
				display: inline-block;
				padding: 0;
				width: 50px;
				height: 45px;
				line-height: 46px;
				text-align: center;
				position: relative;
				opacity: 0;
				margin: 1px 0.5px;
				visibility: hidden;
				transition-property: all;
				transition-timing-function: linear;
				transition-duration: .4s;
				&:hover{
					color: $main_cl_1;
				}
			}
			.buy_now.sold_out{
				background-color: #f00;
				color: #fff;
				cursor: not-allowed !important;
			}
		}
	}
	.product_info {
		text-align: center;
		width: 100%;
		position: relative;
		padding: 20px 5px 20px;
		z-index: 1;
		border-radius: 0 0 30px 30px;
		background: rgba(0,0,0,0);
		.product_title{
			a{
				color: $body_cl_tt;
				font-size: 18px;
				font-weight: bold;
				@extend %smooth-trans1;
				margin-bottom: 10px;
				&:hover{
					color: $body_cl_tt_hv;
				}
			}
		}
		span.sp1 {
			font-size: 18px;
			color: $main_cl_1;
		}
		span.sp2 {
			color: #ccc;
			margin-left: 10px;
		}
		.product_evaluate {
			i {
				font-size: 11px;
			}
		}
		.product_cart_bottom{
			margin-top: 20px;
			a{
				color: $body_cl_tt;
				min-width: 147px;
				min-height: 40px;
				width: 0;
				margin: 0 auto;
			}
		}
	}
}

@media(max-width: 480px){
	.product_item {
		.product_info{
			padding: 10px 5px 20px;
			.product_title{
				a {
					font-size: 14px;
					margin-bottom: 0;
				}
			}
			.product_cart_bottom {
				margin-top: 5px;
				a {
					min-height: 30px;
					width: 100%;
				}
			}
			span.sp1 {
				font-size: 15px;
			}
			span.sp2 {
				font-size: 12px;
			}
		}
		.product_img{
			.product_sale {
				span {
					padding: 0px 5px;
					font-size: 12px;
				}
			}
		}
	}
}



