// --------- POP UP SUBSCRIBE ---------- //


button#popup-btn {
	display: none;
}
.popup {
	display: none;
	position: fixed;
	z-index: 999999999;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	overflow: auto;
	background-color: rgb(0,0,0);
	background-color: rgba(0,0,0,0.6);
	.popup-content {
		background: url('{{'popup_bg.png' | asset_url}}');
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		margin: auto;
		max-width: 750px;
		width: 90%;
		top: 50px;
		position: relative;
		.popup-wrapper {
			background: rgba(255, 255, 255, 0.8);
			padding: 30px 15px;
		}

		.popup-title {
			@extend %text-18;
			@extend %text-bold;
			color: $body_cl_tt;
			margin-bottom: 15px;
		}

		.popup-desc {
			color: $main_cl_2;
			margin-bottom: 15px;
			text-align: justify;
		}

		.popup-list {
			margin-bottom: 15px;

			ul {
				margin: 0;

				li {
					position: relative;
					margin-bottom: 5px;
					padding-left: 15px;

					&:last-child {
						margin: 0 !important;
					}

					&:after {
						content: '\f111';
						font-family: FontAwesome;
						position: absolute;
						top: calc(50% - 3px);
						left: 0;
						font-size: 6px;
						color: $main_cl_2;
						line-height: normal !important;
					}
					color: $main_cl_2;
				}
			}
		}

		.form-desc {
			@extend %text-16;
			color: $main_cl_2;
			margin-bottom: 15px;
		}

		form {
			position: relative;
			width: 100%;

			.input-group {
				width: 100%;
			}

			input {
				width: 100%;
				height: 40px;
				line-height: 40px;
				padding: 0px 45px 0px 15px;
				@extend %text-14;
				color: $main_cl_2;
				background: #fff;
				border: 1px solid #e4e4e4;
				border-radius: 100px !important;
				outline: 0 !important;
				margin-bottom: 15px;
			}

			button {
				position: absolute;
				top: 3px;
				right: 3px;
				height: 34px;
				width: 34px;
				border-radius: 50%;
				display: inline-block;
				background: $bt_bg;
				color: $bt_cl;
				border: solid 1px transparent;
				@extend %text-18;
				@extend %text-bold;
				@extend %text-uppercase;
				@extend %smooth-trans;
				&:hover {
					background: $bt_bg_hv;
					color: $bt_cl_hv;
				}
			}
		}

		.popup-social-network {
			display: inline-block;
			@extend %text-18;
			color: #fff;
			background: $main_cl_2;
			margin-right: 5px;
			margin-bottom: 5px;
			height: 35px;
			width: 35px;
			text-align: center;
			line-height: 35px;
			padding: 0;
			border-radius: 50%;
		}
	}

	.close-popup {
		position: absolute;
		top: -15px;
		right: -15px;
		color: #fff;
		font-size: 18px;
		font-weight: bold;
		display: block;
		height: 30px;
		width: 30px;
		background-color: #ed3c32;
		text-align: center;
		z-index: 9999;
		border-radius: 50%;
		line-height: 30px;
	}

	.close-popup:focus,
	.close-popup:hover {
		color: #fff;
		text-decoration: none;
		cursor: pointer;
	}
	.popup_icon{
		a {
			font-size: 18px;
			width: 38px;
			height: 38px;
			border-radius: 50px;
			line-height: 36px;
			color: #fff;
			display: inline-block;
			text-align: center;
			@extend %smooth-trans1;
			&:hover{
				background-color: #fff !important;
			}
		}
		a.fb-icon {
			background-color: #3c5b9b;
			border: 2px solid #3c5b9b;
			&:hover{
				color: #3c5b9b;
			}
		}
