					>a{
						font-size: 14px;
						position: relative;
						color:$drdow_cl;
						font-weight: 400;
						line-height: 20px;
						text-transform: capitalize;
						display: inline-block;
						text-align: left;
						opacity: .7;
						padding: 8px 0px 8px 0px;
						@extend %smooth-trans;
						&:hover{
							opacity: 1;
							&::after{
								width: 100%;
								left: auto;
								right: 0;
								animation: after_a  0.5s;
