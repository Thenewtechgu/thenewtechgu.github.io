//=====================  collections  =========================//

#collection{
	.wrapper {
		#SortBy{
			background-color: $bt_bg;
			border: 0;
			color: #fff;
		}
		.collection-sidebar-wrapper {
			button.accordion {
				color: $body_cl_tt;
				width: 100%;
				font-size: 25px;
				position: relative;
				padding-left: 25px;
				margin-bottom: 30px;
				font-weight: bold;
				display: flex;
				justify-content: space-between;
				align-items: center;
				&::after {
					content: " ";
					width: 10px;
					height: 10px;
					background-color: $main_cl_1;
					position: absolute;
					top: calc( 50% - 5px);
					left: 0px;
				}
				span {
					width: 100%;
					text-align: left;
				}
				i{
					transform: rotate(0);
					@extend %smooth-trans1;
					color: $body_cl_tt;
					font-size: 14px;
					margin-top: 6px;
				}
			}
			button.accordion.active{
				i{
					transform: rotate(-90deg);
				}
			}
			>.grid-uniform{
				>.grid__item {
					&:first-child{
						padding-top: 0;
						margin-top: 0;
						border: none;
					}
					.panel {
						>ul.clearfix{
							>li{
								padding: 10px 0;
								border-bottom: 1px solid #eeeded;
								margin: 0;
							}
						}
					}
				}
			}
			.collection-filter-size{
				.filter_size{
					li{
						margin-right: 5px !important;
						display: inline-block;
						label{
							width: 40px;
							height: 40px;
							display: flex;
							justify-content: center;
							align-items: center;
							border: solid 1px $bt_bd_cl;
							cursor: pointer;
							@extend %smooth-trans;
							input{
								visibility: hidden;
								position: absolute;
							}
						}
						label.checked{
							border: solid 1px $body_cl_tt_hv;
							span{
								color: $body_cl_tt_hv;
							}
						}
					}
				}
			}
		}
	}
	.collection-content-wrapper{
		.collection-head{
			display: flex;
			justify-content: flex-end;
			margin: 0 0 30px;
			padding: 0px 15PX 15px 30px;
