//============================================ cart_modal  ===============================================//
#cart_modal{
	.cart_modal_all{
		width: 420px;
		min-height: 100vh;
		padding: 2rem;
		position: fixed;
		top: 0;
		z-index: 102;
		background-color: #fff;
		right: -100%;
		overflow-y: auto;
		overflow-x: hidden;
		@extend %smooth-trans1;
		h2 {
			font-weight: 400;
			font-size: 24px;
			color: $body_cl_tt;
			.btnCloseQVCart{
				margin-left: 20px;
				cursor: pointer;
				position: absolute;
				&:hover{
					img{
						filter: grayscale(0%);
						opacity: 1;
					}
				}
				img{
					width: 16px;
					webkit-filter: grayscale(100%);
					filter: grayscale(100%);
					opacity: .5;
					-webkit-transition: opacity .3s ease,-webkit-filter .3s ease;
					transition: opacity .3s ease,-webkit-filter .3s ease;
					transition: filter .3s ease,opacity .3s ease;
					transition: filter .3s ease,opacity .3s ease,-webkit-filter .3s ease;
					-webkit-transition: -webkit-filter .3s ease,opacity .3s ease;
				}
			}
		}
		.cart_menu{
			&::-webkit-scrollbar {
				width: 5px;
			}
			&::-webkit-scrollbar-thumb {
				background: $bt_bg_hv; 
				border-radius: 30px;
			}
			.cart_item{
				display: flex;
				margin-top: 30px;
				a.cart__remove{
					&:hover{
						img{
							filter: grayscale(0%);
							opacity: 1;
						}
					}
					img{
						width: auto;
						webkit-filter: grayscale(100%);
						filter: grayscale(100%);
						opacity: .5;
						-webkit-transition: opacity .3s ease,-webkit-filter .3s ease;
						transition: opacity .3s ease,-webkit-filter .3s ease;
						transition: filter .3s ease,opacity .3s ease;
						transition: filter .3s ease,opacity .3s ease,-webkit-filter .3s ease;
						-webkit-transition: -webkit-filter .3s ease,opacity .3s ease;
					}
				}
				.cart_img{
					width: 25%;
					a{
						display: block;
					}
				}
				.cart_info{
					width: 75%;
					padding-left: 15px;
					a{
						color: $body_cl_tt;
						font-weight: bold;
						@extend %smooth-trans1;
						&:hover{
							color: $body_cl_tt_hv;
						}
					}
					.variant{
						.sp1{
							color: $main_cl_1;
						}
						.sp2{
							width: 15px;
							height: 15px;
							border-radius: 30px;
							display: inline-block;
							vertical-align: middle;
							border: solid 1px #ccc;
						}
					}
					.cart_price_quantity{
						>span{
							display: block;
							.sp2{
								color: $main_cl_1;
								font-weight:bold;
							}
						}
					}
				}
			}
		}
		.qv-cart-total {
			text-align: center;
			margin: 15px 0 10px;
			font-weight: bold;
			font-size: 18px;
			color: $body_cl_tt;
			span{
				color: $main_cl_1;
				font-weight: bold;
			}
		}
		.quickview-cartactions{
			margin: 15px 0;
			display: flex;
			a{
				position: relative;
				display: block;
				color: $bt_bg_hv;
				background-color: $bt_bg;
				font-size: 16px;
				min-height: 55px;
				line-height: 55px;
				text-align: center;
				margin-bottom: 20px;
				padding: 0;
				width: 50%;
				font-weight: bold;
				@extend %smooth-trans1;
				&:hover{
					color: $bt_cl;
					background-color: $bt_bg_hv;
					&::after {
						background-color: $bt_bg_hv;
					}
				}
				&::after {
					content: '';
					position: absolute;
					left: 0;
					bottom: -6px;
					height: 3px;
					width: 100%;
					background-color: $bt_bg;
					@extend %smooth-trans1;
				}
			}
			a.viewcart{
				margin-right: 20px;
			}
		}
	}
	.cart_modal_bg {
		background-color: rgba(17, 17, 17, 0.7);
		z-index: 102;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		@extend %smooth-trans1;
	}
}
#cart_modal.active{
	.cart_modal_all{
		right: 0;
	}
	.cart_modal_bg {
		opacity: 1;
		visibility: visible;
		pointer-events: all;
	}
}

@media(max-width: 480px){
	#cart_modal {
		.cart_modal_all {
			width: 300px;
			padding: 1rem;
			h2 {
				font-size: 20px;
				margin-bottom: 1rem !important;
			}
		}
	}
}



