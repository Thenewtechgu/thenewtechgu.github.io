//======================== back_top ==================================//

#back_top {
	position: fixed;
	bottom: 20px;
	right: 20px;
	width: 40px;
	top: auto !important;
	height: 40px;
	background-color: $main_cl_1;
	transform: translateX(200%);
	z-index: 101;

	@extend %smooth-trans;
	&:hover{
		background-color: $body_cl_tt;
	}
	a {
		color: #fff;
		width: 100%;
		height: 100%;
		display: flex;
		justify-content: center;
		align-items: center;;
	}
}

#back_top.back_to_top {
	transform: translateX(0);
}

.hieght_vh .cart_menu{
	height: 50vh !important;
	overflow-y: auto;
	overflow-x: hidden;
	margin-right: -2rem;
	padding-right: 2rem;
}

@media(max-width: 480px){
	#back_top {
		bottom: 80px;
	}
}

