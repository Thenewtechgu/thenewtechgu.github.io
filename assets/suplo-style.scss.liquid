#home-tab1{
	padding: 0px 0 70px;
	.tab_menu {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		li {
			background-color: #f2f2f2;
			a {
				text-transform: capitalize;
				line-height: 1;
				position: relative;
				font-size: 16px;
				color: $body_cl_tt;
				padding: 10px 10px 10px 20px;
				opacity: .7;
				@extend %smooth-trans;
				&::after{
					content: '';
					width: 100%;
					height: 2px;
					background-color: $main_cl_1;
					position: absolute;
					bottom: -15px;
					left: 0;
					opacity: .7;
					visibility: hidden;
					@extend %smooth-trans;
				}
				&:hover{
					&::after{
						color: $main_cl_1;
						visibility: visible;
						bottom: -4px;
					}
				}
			}
		}
		li.active{
			a{
				color: $main_cl_1;
				visibility: visible;
				bottom: 0;
				&::after{
					color: $main_cl_1;
					visibility: visible;
					bottom: -4px;
				}
			}
		}
	}
	@keyframes round {
		0% {-webkit-transform: rotate(0deg);}
		100% {-webkit-transform: rotate(359deg);}
	}
	.tab_product_title {
		margin-bottom: 45px;
	}


	.tabcontent {
		padding-top: 50px;
		display: none;
		opacity: 1;
		animation:hide_tab 0.5s;
		text-align: center;
		.service_title {

			h4{
				margin-top: 7px;
				a{
					font-weight: bold;
					color: $body_cl;
					@extend %smooth-trans1;
					&:hover{
						color: $body_cl_tt_hv;
					}
				}
			}
		}
		.service_item{
			position: relative;
			box-shadow: 0px 0px 13px #f0f0f0;
			a{
				display: block;
			}
			.service_img{
				overflow: hidden;
				display: block;
				img{
					@extend %smooth-trans1;
				}
			}
			&:hover{
				img{
					transform: scale(1.2);
				}
				.service_info{
					transform: scale(0.9);
				}
			}
			.service_info {
				position: absolute;
				bottom: 0;
				left: 0;
				width: 100%;
				z-index: 2;
				color: #fff;
				height: 100%;
				background-color: rgba(0,0,0,0.6);
				transform: scale(0);
				@extend %smooth-trans;

			}
		}
		.grid__item {
			float: none;
			display: inline-block;
			vertical-align: top;
			margin-right: -3px;
		}
	}
	.tabcontent.active{
		display:block !important;
		animation:show_tab 0.5s;
		padding-top: 0;
		opacity: 1;
	}

	@keyframes show_tab{
		from {
			opacity: 0;
			display:block !important;
			padding-top: 50px;
		}
		to {
			opacity: 1;
			display:block !important;
			padding-top: 0;

		}
	}

	@keyframes hide_tab{
		from {
			opacity: 1;
			display:block !important;
			padding-top: 0;

		}
		to {
			opacity: 0;
			display:block !important;
			padding-top: 30px;

		}
	}
}


